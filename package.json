{
  "name": "@inhuman/dsh-rail-navigator",
  "version": "0.0.1",
  "description": "Recent workspace and session navigation from the collapsed DSH sidebar rail.",
  "type": "module",
  "license": "MIT",
  "author": "inhuman",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "sessions",
    "workspaces"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
